<!DOCTYPE html>
<html>

<head>

<meta charset="UTF-8">

<style>

body{
    font-family:Arial,sans-serif;
    margin:40px;
    color:#222;
}

.header{
    display:flex;
    justify-content:space-between;
    border-bottom:2px solid #000;
    padding-bottom:15px;
}

.company h1{
    margin:0;
}

.company p{
    margin:2px 0;
}

.bill{
    text-align:right;
}

.section{
    margin-top:25px;
}

.section h3{
    margin-bottom:8px;
}

table{
    width:100%;
    border-collapse:collapse;
    margin-top:10px;
}

th{
    background:#f5f5f5;
}

th,
td{
    border:1px solid #ccc;
    padding:8px;
    text-align:left;
}

.footer{
    margin-top:80px;
    text-align:center;
    font-size:12px;
}

</style>

</head>

<body>

<div class="header">

<div class="company">

<h1>{{company.name}}</h1>

<p>{{company.address}}</p>

<p>{{company.phone}}</p>

<p>{{company.email}}</p>

<p>GST : {{company.gst}}</p>

</div>

<div class="bill">

<h2>VENDOR BILL</h2>

<p>Bill No : {{bill.billNumber}}</p>

<p>Date : {{bill.billDate}}</p>

</div>

</div>

<div class="section">

<h3>Vendor Details</h3>

<p>

<b>{{vendor.companyName}}</b>

<br>

{{vendor.address}}

<br>

{{vendor.phone}}

</p>

</div>

<div class="section">

<h3>Event Details</h3>

<table>

<tr>
<td>Event</td>
<td>{{event.eventName}}</td>
</tr>

<tr>
<td>Venue</td>
<td>{{event.venue.name}}</td>
</tr>

<tr>
<td>Duty Date</td>
<td>{{duty.dutyDateFormatted}}</td>
</tr>

</table>

</div>

<div class="section">

<h3>Vehicle Details</h3>

<table>

<tr>
<td>Vehicle Number</td>
<td>{{vehicle.vehicleNumber}}</td>
</tr>

<tr>
<td>Driver</td>
<td>{{driver.name}}</td>
</tr>

<tr>
<td>Driver Phone</td>
<td>{{driver.phone}}</td>
</tr>

</table>

</div>

<div class="section">

<h3>Billing Summary</h3>

<table>

<tr>
<th>Description</th>
<th>Amount</th>
</tr>

<tr>
<td>Vendor Rate</td>
<td>{{bill.vendorRate}}</td>
</tr>

<tr>
<td>Total KM</td>
<td>{{bill.totalKm}}</td>
</tr>

<tr>
<td>Total Hours</td>
<td>{{bill.totalHours}}</td>
</tr>

<tr>
<td>Extra KM</td>
<td>{{bill.extraKm}}</td>
</tr>

<tr>
<td>Extra Hour</td>
<td>{{bill.extraHour}}</td>
</tr>

<tr>
<td>Parking Charges</td>
<td>{{bill.parkingCharges}}</td>
</tr>

<tr>
<td>Toll Charges</td>
<td>{{bill.tollCharges}}</td>
</tr>

<tr>
<td>Entry Charges</td>
<td>{{bill.entryCharges}}</td>
</tr>

<tr>
<td>DA Charges</td>
<td>{{bill.daCharges}}</td>
</tr>

<tr>
<td><b>Total Payable</b></td>
<td><b>{{bill.totalAmount}}</b></td>
</tr>

</table>

</div>

<div class="section">

<h3>Approval</h3>

<table>

<tr>
<td>Status</td>
<td>{{bill.status}}</td>
</tr>

<tr>
<td>Approved By</td>

<td>

{{#if approvedBy}}

{{approvedBy.name}}

{{else}}

Pending

{{/if}}

</td>

</tr>

<tr>
<td>Approved At</td>
<td>{{bill.approvedAtFormatted}}</td>
</tr>

</table>

</div>

<div class="footer">

Generated by Transit Fleets ERP

</div>

</body>

</html>