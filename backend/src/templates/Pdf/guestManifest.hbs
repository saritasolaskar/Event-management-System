<!DOCTYPE html>
<html>

<head>

<meta charset="UTF-8">

<style>

body{
font-family:Arial,sans-serif;
margin:35px;
font-size:13px;
color:#222;
}

.header{
text-align:center;
border-bottom:2px solid #000;
padding-bottom:15px;
margin-bottom:20px;
}

.section{
margin-top:20px;
}

table{
width:100%;
border-collapse:collapse;
margin-top:10px;
}

th,td{
border:1px solid #ccc;
padding:8px;
font-size:12px;
text-align:left;
}

th{
background:#f2f2f2;
}

.summary{
margin-top:25px;
width:45%;
}

.footer{
margin-top:50px;
text-align:center;
font-size:11px;
color:#666;
}

</style>

</head>

<body>

<div class="header">

<h1>{{company.name}}</h1>

<p>{{company.address}}</p>

<p>{{company.phone}}</p>

<p>{{company.email}}</p>

<h2>Guest Manifest</h2>

</div>

<div class="section">

<table>

<tr>
<td>Event</td>
<td>{{event.eventName}}</td>
</tr>

<tr>
<td>Client</td>
<td>{{client.companyName}}</td>
</tr>

<tr>
<td>Venue</td>
<td>{{event.venue.name}}</td>
</tr>

<tr>
<td>Start Date</td>
<td>{{event.startDateFormatted}}</td>
</tr>

<tr>
<td>End Date</td>
<td>{{event.endDateFormatted}}</td>
</tr>

</table>

</div>

<div class="section">

<h3>Guest List</h3>

<table>

<tr>

<th>Sr.</th>
<th>Guest</th>
<th>Company</th>
<th>Mobile</th>
<th>Vehicle</th>
<th>Driver</th>
<th>Pickup</th>
<th>Drop</th>
<th>Status</th>

</tr>

{{#if guests.length}}

{{#each guests}}

<tr>

<td>{{inc @index}}</td>

<td>{{this.name}}</td>

<td>{{this.company}}</td>

<td>{{this.phone}}</td>

<td>{{this.vehicleAssignment.vehicle.vehicleNumber}}</td>

<td>{{this.vehicleAssignment.driver.name}}</td>

<td>{{this.pickupLocation.name}}</td>

<td>{{this.dropLocation.name}}</td>

<td>{{this.status}}</td>

</tr>

{{/each}}

{{else}}

<tr>

<td colspan="9" style="text-align:center;">
No Guests Found
</td>

</tr>

{{/if}}

</table>

</div>

<div class="section">

<h3>Summary</h3>

<table class="summary">

<tr>
<td>Total Guests</td>
<td>{{summary.totalGuests}}</td>
</tr>

<tr>
<td>Assigned</td>
<td>{{summary.assigned}}</td>
</tr>

<tr>
<td>Pending</td>
<td>{{summary.pending}}</td>
</tr>

<tr>
<td>Picked Up</td>
<td>{{summary.pickedUp}}</td>
</tr>

<tr>
<td>Dropped</td>
<td>{{summary.dropped}}</td>
</tr>

</table>

</div>

<div class="footer">

Generated by Transit Fleets ERP

<br><br>

Generated On : {{generatedAt}}

</div>

</body>

</html>